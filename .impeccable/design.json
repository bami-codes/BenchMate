      "css": ".ds-provenance{display:flex;gap:7px;flex-wrap:wrap}.ds-badge{display:inline-flex;align-items:center;min-height:25px;padding:3px 8px;border:1px solid var(--line,#dce3dc);border-radius:4px;background:var(--surface,#fff);color:var(--ink,#1c2b27);font:600 11px/1.5 var(--font,Plex,Arial,sans-serif);white-space:nowrap}.ds-source{border-color:#dfc7a4;background:#fff6e7;color:#895118}"
