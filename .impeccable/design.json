      "css": ".ds-step{border:1px solid var(--line,#dce3dc);border-radius:5px;background:var(--surface,#fff);color:var(--ink,#1c2b27);min-height:36px;padding:7px 12px;display:inline-flex;align-items:center;justify-content:center;gap:8px;white-space:nowrap;font:600 12px/1.5 var(--font,Plex,Arial,sans-serif);cursor:pointer;transition:background 150ms ease-out;width:32px;padding:4px;background:transparent;border:0}.ds-step:hover:not(:disabled){background:var(--tint,#eaf1eb)}.ds-step:focus-visible{outline:2px solid var(--accent,#1f6954);outline-offset:4px}.ds-step:disabled{cursor:default;opacity:.45}@media(max-width:800px){.ds-step{min-height:40px}}@media(prefers-reduced-motion:reduce){.ds-step{transition:none}}.ds-step svg{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linejoin:round;stroke-linecap:round;flex:none}@media(max-width:480px){.ds-step{width:26px}}"
