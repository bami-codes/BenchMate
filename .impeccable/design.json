      "name": "Replay action",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The explicit action that advances recorded experiment events.",
      "html": "<button class=\"ds-replay\"><svg viewBox=\"0 0 20 20\" aria-hidden=\"true\"><path d=\"m7 4 8 6-8 6Z\"/></svg><span>Replay run</span></button>",
      "css": ".ds-replay{border:1px solid var(--line,#dce3dc);border-radius:5px;background:var(--surface,#fff);color:var(--ink,#1c2b27);min-height:36px;padding:7px 12px;display:inline-flex;align-items:center;justify-content:center;gap:8px;white-space:nowrap;font:600 12px/1.5 var(--font,Plex,Arial,sans-serif);cursor:pointer;transition:background 150ms ease-out;background:var(--accent,#1f6954);border-color:var(--accent,#1f6954);color:var(--surface,#fff)}.ds-replay:hover:not(:disabled){background:var(--accent-hover,#164c3e)}.ds-replay:focus-visible{outline:2px solid var(--accent,#1f6954);outline-offset:4px}.ds-replay:disabled{cursor:default;opacity:.45}@media(max-width:800px){.ds-replay{min-height:40px}}@media(prefers-reduced-motion:reduce){.ds-replay{transition:none}}.ds-replay svg{width:14px;height:14px;fill:currentColor;stroke:none;flex:none}"
    },
