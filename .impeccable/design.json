      "css": ".ds-actors{display:flex;gap:8px;flex-wrap:wrap}.ds-actor{display:inline-flex;align-items:center;border:1px solid #d7e1d9;border-radius:4px;min-height:21px;padding:1px 6px;color:#496157;font:600 10px/1.5 var(--font,Plex,Arial,sans-serif);white-space:nowrap}.ds-spark{color:#254f80;background:#edf3fa;border-color:#c9d9ec}.ds-operator{color:#805323;background:#fcf3e7;border-color:#e7d5bb}.ds-engine{background:#f0f3ee}"
    },
    {
      "name": "Evidence surface",
      "kind": "card",
      "refersTo": "surface",
      "description": "The shared white frame and heading treatment of the figure and trail.",
      "html": "<section class=\"ds-surface\"><div class=\"ds-heading\"><h2 class=\"ds-title\">Prediction &amp; observation</h2></div></section>",
      "css": ".ds-surface{background:var(--surface,#fff);border:1px solid var(--line,#dce3dc);border-radius:var(--radius,8px);overflow:hidden;min-width:0;color:var(--ink,#1c2b27)}.ds-heading{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:15px 18px}.ds-title{margin:0;font:600 15px/1.5 var(--font,Plex,Arial,sans-serif);letter-spacing:-.01em}@media(max-width:1100px){.ds-heading{padding:13px 14px}}@media(max-width:480px){.ds-heading{gap:7px}.ds-title{font-size:14px}}"
    },
    {
      "name": "Waveform channel controls",
      "kind": "custom",
      "refersTo": "trace-toggle",
      "description": "Native pressed-state buttons distinguish solid observation, dashed prediction and optional drive.",
      "html": "<div class=\"ds-traces\" role=\"group\" aria-label=\"Waveform channels\"><button class=\"ds-trace\" aria-pressed=\"true\"><span class=\"ds-line\"></span>Observed OUT</button><button class=\"ds-trace ds-predicted\" aria-pressed=\"true\"><span class=\"ds-line\"></span>Predicted OUT</button><button class=\"ds-trace ds-drive\" aria-pressed=\"false\"><span class=\"ds-line\"></span>Drive</button></div>",
      "css": ".ds-traces{display:flex;align-items:center;gap:14px;flex-wrap:wrap}.ds-trace{padding:3px 0;border:0;background:transparent;font:400 11px/1.5 var(--font,Plex,Arial,sans-serif);color:var(--secondary,#55635e);display:flex;align-items:center;gap:6px;min-height:28px;cursor:pointer}.ds-trace:hover{color:var(--ink,#1c2b27)}.ds-trace:focus-visible{outline:2px solid var(--accent,#1f6954);outline-offset:4px}.ds-line{display:inline-block;width:16px;height:3px;background:var(--observed,#bb4c27)}.ds-predicted .ds-line{background:transparent;border-top:2px dashed var(--predicted,#315e91)}.ds-drive .ds-line{background:var(--drive,#7a827e)}.ds-trace[aria-pressed=false] .ds-line{opacity:.4;background:transparent;border:1px solid currentColor}@media(max-width:800px){.ds-trace{min-height:36px}}@media(max-width:480px){.ds-trace{font-size:10px}.ds-traces{gap:12px}}"
    },
    {
      "name": "Experiment trail navigation",
      "kind": "nav",
      "refersTo": "trail-event",
      "description": "An action row aligns elapsed time, responsible actor and event; current state uses tint and weight.",
      "html": "<ol class=\"ds-trail\" aria-label=\"Experiment actions\"><li><button class=\"ds-event\" aria-current=\"step\"><span class=\"ds-time\">—</span><span class=\"ds-trail-actor\">Engine</span><span class=\"ds-event-label\">Prediction committed</span><svg viewBox=\"0 0 20 20\" aria-hidden=\"true\"><path d=\"M5 10h9m-4-4 4 4-4 4\"/></svg></button></li></ol>",
      "css": ".ds-trail{margin:0;padding:5px 8px;list-style:none;max-height:174px;overflow:auto;scrollbar-color:#b9c6bd transparent;scrollbar-width:thin}.ds-event{display:grid;grid-template-columns:48px 64px minmax(0,1fr) 18px;align-items:center;gap:12px;width:100%;border:0;border-radius:5px;text-align:left;background:none;padding:9px 10px;color:var(--ink,#1c2b27);min-height:43px;cursor:pointer;font:400 14px/1.5 var(--font,Plex,Arial,sans-serif)}.ds-event:hover{background:#f0f4ee}.ds-event[aria-current=step]{background:var(--tint,#eaf1eb)}.ds-event[aria-current=step] .ds-event-label{font-weight:600}.ds-event:focus-visible{outline:2px solid var(--accent,#1f6954);outline-offset:4px}.ds-time{font:10px var(--mono,ui-monospace,SFMono-Regular,Consolas,monospace);color:var(--secondary,#55635e)}.ds-event-label{font-size:12px;overflow-wrap:anywhere}.ds-trail-actor{justify-self:start;display:inline-flex;align-items:center;border:1px solid #d7e1d9;border-radius:4px;min-height:21px;padding:1px 6px;color:#496157;background:#f0f3ee;font-size:10px;white-space:nowrap;font-weight:600}.ds-event svg{width:15px;height:15px;stroke:var(--accent,#1f6954);fill:none;stroke-width:1.5}@media(max-width:800px){.ds-trail{max-height:300px}.ds-event{min-height:44px}}@media(max-width:480px){.ds-event{grid-template-columns:37px 55px minmax(0,1fr) 12px;gap:8px;padding:9px 7px}.ds-event-label{font-size:11px}}"
    }
  ],
  "narrative": {
    "northStar": "The Scientific Poster",
    "overview": "BenchMate uses the clarity of a well-typeset scientific poster: a dominant data figure, aligned captions, a concise interpretation column and a traceable methods sequence. Warm off-white ground, white figures and a dark green masthead give a compact working surface a calm, deliberate character. The interface is in English and supports operating and reviewing an experiment.\n\nThe waveform carries the visual emphasis. Interpretation stays beside evidence; actor labels and provenance stay readable without becoming decorative metrics. The world is built with typography, rules and inline vector diagrams, with embedded fonts and no external runtime assets needed by an exported report.",
    "keyCharacteristics": [
      "A large evidence figure with a restrained interpretation column.",
      "Dark green actions and shell, off-white ground and white bounded surfaces.",
      "Solid orange observations and dashed blue precommitted predictions.",
      "Flat depth, modest corners and fine dividers.",
      "Explicit actors, independent provenance labels and accessible native controls."
    ],
    "rules": [
      {
        "name": "The Independent Provenance Rule.",
        "body": "Keep data origin and viewing mode as separate labels. Live transport never supplies a physical or calibrated status.",
        "section": "colors"
      },
      {
        "name": "The Flat Surface Rule.",
        "body": "Use tone, borders and spacing to separate information; keep controls and evidence surfaces flat at rest and on hover.",
        "section": "elevation"
      },
      {
        "name": "The Evidence Order Rule.",
        "body": "Show only conclusions supported by the selected event prefix, and preserve the distinction between prediction before acquisition and observation after it.",
        "section": "components"
      }
    ],
    "dos": [
      "**Do** keep the waveform visually dominant and the explanation adjacent to its evidence.",
      "**Do** preserve solid observed and dashed predicted traces, with text labels for both.",
      "**Do** show the responsible actor and keep source origin separate from replay or live transport.",
      "**Do** retain native keyboard controls, visible focus, accessible labels and reduced-motion support.",
      "**Do** preserve the narrow-screen order: figure, report, trail, connections.",
      "**Do** keep full reports, original events and source hashes accessible through disclosure."
    ],
    "donts": [
      "**Don't** infer calibrated hardware from a live connection, an animation or a successful software check.",
      "**Don't** reveal future conclusions or attribute an engine summary to the model without evidence.",
      "**Don't** add simulated instrument casing, decorative metrics or unsupported measurement precision.",
      "**Don't** replace the flat paper-like hierarchy with shadows, gradients or ornamental imagery.",
      "**Don't** promote compact metadata sizes into defaults for ordinary reading text."
    ]
  }
}
